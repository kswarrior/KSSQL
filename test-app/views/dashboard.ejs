<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | KS Test App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #09090b; color: #f4f4f5; }
        .glass { background: rgba(24, 24, 27, 0.8); backdrop-filter: blur(12px); border: 1px solid #27272a; }
    </style>
</head>
<body class="min-h-screen">
    <nav class="h-16 border-b border-[#27272a] flex items-center justify-between px-8 glass sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span class="font-bold tracking-tight text-xl">KS TEST APP</span>
        </div>
        <div class="flex items-center gap-6">
            <span class="text-sm text-zinc-400 hidden sm:block">Logged in as <span class="text-white font-medium"><%= user %></span></span>
            <a href="/logout" class="text-xs font-bold uppercase tracking-widest text-zinc-500 hover:text-white transition-colors">Logout</a>
        </div>
    </nav>

    <main class="p-8 lg:p-12 max-w-6xl mx-auto space-y-12">
        <div class="space-y-2">
            <h1 class="text-4xl font-extrabold tracking-tighter">System Dashboard</h1>
            <p class="text-zinc-500">Live data directly from KS SQL core engine.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-[#18181b] border border-[#27272a] rounded-2xl p-6 space-y-4">
                <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Active Users</span>
                <div class="text-5xl font-bold tabular-nums"><%= allUsers.length %></div>
                <div class="h-1 bg-zinc-800 rounded-full overflow-hidden"><div class="h-full bg-emerald-500 w-1/3"></div></div>
            </div>
            <div class="bg-[#18181b] border border-[#27272a] rounded-2xl p-6 space-y-4">
                <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Engine Status</span>
                <div class="flex items-center gap-3">
                    <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-xl font-bold uppercase tracking-tight">Healthy</span>
                </div>
                <p class="text-xs text-zinc-500">Titan-Prime V1.1.0 Online</p>
            </div>
            <div class="bg-[#18181b] border border-[#27272a] rounded-2xl p-6 space-y-4">
                <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Session ID</span>
                <div class="text-xl font-mono text-zinc-300 truncate"><%= Math.random().toString(36).substring(7).toUpperCase() %></div>
                <p class="text-xs text-zinc-500">Temporary Verification Token</p>
            </div>
        </div>

        <div class="bg-[#18181b] border border-[#27272a] rounded-2xl overflow-hidden">
            <div class="p-6 border-b border-[#27272a] bg-zinc-900/50">
                <h3 class="font-bold">User Directory (SQL Result)</h3>
            </div>
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-zinc-500 border-b border-[#27272a]">
                        <th class="px-6 py-4 font-medium">Username</th>
                        <th class="px-6 py-4 font-medium text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#27272a]">
                    <% allUsers.forEach(u => { %>
                        <tr class="hover:bg-zinc-900/50 transition-colors">
                            <td class="px-6 py-4 font-medium text-zinc-200"><%= u.username %></td>
                            <td class="px-6 py-4 text-right"><span class="px-2 py-1 bg-emerald-500/10 text-emerald-500 text-[10px] font-bold rounded-md uppercase">Verified</span></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>
